# Copy to .env.local for local dev only. Never commit .env.local.
#
# Split hosting:
# - Leave NEXT_PUBLIC_API_BASE_URL empty (browser uses same-origin /api/*).
# - Set API_PROXY_TARGET in Vercel project env (encrypted at rest), not in git.

NEXT_PUBLIC_API_BASE_URL=

# Server-side rewrite target (required for production builds; dev-only localhost fallback).
API_PROXY_TARGET=http://localhost:8080
